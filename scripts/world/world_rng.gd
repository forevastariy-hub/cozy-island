class_name WorldRng
extends RefCounted

# Deterministic random streams. Each subsystem gets its own stream so that
# adding a feature never shifts coordinates generated by another subsystem.

var _rng := RandomNumberGenerator.new()

func _init(world_seed: int, stream: String) -> void:
	_rng.seed = int(world_seed) * 2654435761 + stream.hash()

func rng() -> RandomNumberGenerator:
	return _rng

func randf() -> float:
	return _rng.randf()

func randf_range(a: float, b: float) -> float:
	return _rng.randf_range(a, b)

func randi_range(a: int, b: int) -> int:
	return _rng.randi_range(a, b)

func random_point_in(poly: PackedVector2Array) -> Vector2:
	if poly.is_empty():
		return Vector2.ZERO
	var mn := poly[0]
	var mx := poly[0]
	for p in poly:
		mn = Vector2(minf(mn.x, p.x), minf(mn.y, p.y))
		mx = Vector2(maxf(mx.x, p.x), maxf(mx.y, p.y))
	for _i in 32:
		var q := Vector2(_rng.randf_range(mn.x, mx.x), _rng.randf_range(mn.y, mx.y))
		if Geometry2D.is_point_in_polygon(q, poly):
			return q
	return (mn + mx) * 0.5

func random_in_ellipse(center: Vector2, radii: Vector2, rng_scale: float = 0.85) -> Vector2:
	var a := _rng.randf_range(0.0, TAU)
	var r := sqrt(_rng.randf()) * rng_scale
	return center + Vector2(cos(a) * radii.x, sin(a) * radii.y) * r
